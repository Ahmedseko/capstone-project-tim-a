PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=global_parfum_kutoarjo
JWT_SECRET=change-this-to-a-long-random-string

# Produksi: NODE_ENV=production dan JWT_SECRET acak yang panjang (server menolak start dengan nilai bawaan).
# Frontend dan API biasanya satu origin (Nginx), jadi CORS_ORIGIN dibiarkan kosong. Isi daftar origin dipisah koma
# hanya kalau frontend dilayani dari domain lain.
# NODE_ENV=production
# CORS_ORIGIN=https://contoh.com
